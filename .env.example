# Orion Chatbot — Configuration
# Copy this file to .env and fill in the values.
# DO NOT commit .env with real secrets to git.

# ── AI (Kiro Gateway / Claude) ──────────────────────────────────────────────
# The Kiro Gateway is a local proxy that gives access to Claude AI.
# If these are empty, the bot uses simple keyword rules instead (offline mode).
KIRO_GATEWAY_URL=https://your-cloudflare-tunnel.trycloudflare.com
KIRO_GATEWAY_API_KEY=your-proxy-api-key-here
KIRO_GATEWAY_MODEL=claude-haiku-4.5

# ── Instagram / Meta ─────────────────────────────────────────────────────────
# Get this from Meta Developer Console → Your App → Instagram → Page Access Token
# Use a long-lived token (60 days) — short-lived tokens expire in hours.
# If empty, the bot logs replies instead of sending them (useful for local testing).
IG_PAGE_ACCESS_TOKEN=

# This token must match what you set in Meta Developer Console → Webhooks
META_VERIFY_TOKEN=Orion_verify_token

# ── Telegram (optional — for staff order notifications) ──────────────────────
# If empty, order notifications are just logged to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=
